#!/usr/bin/env bash
# Lists lines this branch added in src/ (.tsx/.css, outside src/index.css) that use a raw hex color
# or a pixel size other than 1px/2px. Exits 1 if there are any. Used by /design-check.
set -euo pipefail
cd "$(dirname "$0")/../.."

pattern='#[0-9a-fA-F]{3,8}\b|\b([3-9]|[0-9]{2,})px\b'
base=$(git merge-base HEAD main 2>/dev/null || git rev-parse HEAD)
found=0
while IFS= read -r f; do
  case "$f" in src/index.css) continue ;; src/*.tsx | src/*.css) ;; *) continue ;; esac
  [ -f "$f" ] || continue
  if git ls-files --error-unmatch "$f" >/dev/null 2>&1; then
    lines=$(git diff -U0 "$base" -- "$f" | grep -E '^\+[^+]' | cut -c2- || true)
  else
    lines=$(cat "$f")
  fi
  while IFS= read -r line; do
    if printf '%s\n' "$line" | grep -qE "$pattern"; then
      echo "$f: $line"
      found=1
    fi
  done <<<"$lines"
done < <({ git diff --name-only "$base"; git ls-files --others --exclude-standard; } | sort -u)
exit "$found"
