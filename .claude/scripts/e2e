#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/../.."
# A ticket worktree gets its own port, so parallel tickets can run their dev servers at once.
[ ! -f .claude/ticket.env ] || { set -a; . .claude/ticket.env; set +a; }
# One worker: every spec and project shares the dev server's data/submissions.json, and a spec that completes
# a job would otherwise close it under another spec that's answering it (e2e/submissions.ts).
pnpm exec playwright test --workers=1 "$@"
