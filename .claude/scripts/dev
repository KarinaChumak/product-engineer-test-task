#!/usr/bin/env bash
# Starts the API (Hono, src/server) and Vite together. Vite proxies /api to the API.
set -euo pipefail
cd "$(dirname "$0")/../.."
# A ticket worktree gets its own port, so parallel tickets can run their dev servers at once.
[ ! -f .claude/ticket.env ] || { set -a; . .claude/ticket.env; set +a; }
PORT=${PORT:-5173}
# The API port follows the Vite port, so parallel worktrees don't share an API either.
export API_PORT=${API_PORT:-$((PORT + 1000))}

pnpm exec tsx watch --clear-screen=false src/server/index.ts &
api=$!
trap 'kill "$api" 2>/dev/null || true' EXIT INT TERM

pnpm exec vite --port "$PORT" --strictPort "$@"
